# OMNIA backend — copy to .env and fill values. Never commit .env.

# --- Core (required) ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=omnia
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
COOKIE_SECURE=false

# --- Super admin seed (startup apps.core.seed) ---
# Required for Cloud Agent / local boot to create Founder + demo agency.
ADMIN_EMAIL=mcnicastro@gmail.com
ADMIN_PASSWORD=OmniaFounder2026!
# Demo agency_admin (seed.py) — default if unset: OmniaDemo2026!
DEMO_ADMIN_PASSWORD=OmniaDemo2026!
# Aliases used by some pytest modules
OMNIA_ADMIN_EMAIL=mcnicastro@gmail.com
OMNIA_ADMIN_PASSWORD=OmniaFounder2026!

# --- Public URLs ---
FRONTEND_URL=http://127.0.0.1:43122
FRONTEND_BASE_URL=http://127.0.0.1:43122
OMNIA_PUBLIC_URL=http://127.0.0.1:43122
PUBLIC_BASE_URL=http://127.0.0.1:43121
REACT_APP_BACKEND_URL=http://127.0.0.1:43121

# --- LLM (Gemini — preferred) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash   # default shared/llm (P-024; avoid deprecated gemini-2.0-flash)
# GOOGLE_API_KEY=   # alias accepted
# EMERGENT_LLM_KEY= # legacy alias only (mirrored from GEMINI at boot if unset)

# --- Object storage ---
STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT=   # default: backend/.media
# STORAGE_BACKEND=emergent  # legacy only (needs EMERGENT_LLM_KEY / Gemini key)

# --- Backup (D-114 / O0 / S2) ---
# BACKUP_ROOT=          # default: backend/.backups
# BACKUP_RETENTION_DAYS=7   # O0 hot ≤7g (default codice=7; was 30 as-is)

# --- Email ---
# RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# --- Stripe (sandbox) ---
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MODE=test
# OMNIA_SELF_SERVE_ENABLED=false   # S5/D-115: checkout B2B OFF finché O6 PASS (≠ Stripe sandbox)

# --- Media AI ---
# FAL_KEY=

# --- Optional ---
# TAVILY_API_KEY=
# CREDENTIALS_MASTER_KEY=
# OMNIA_CUSTOM_DOMAIN_CNAME_TARGET=

# --- Google Sign-In (optional) ---
# Create OAuth 2.0 Web Client in Google Cloud Console → APIs & Services → Credentials
# Authorized JavaScript origins: http://127.0.0.1:43122  (+ production domain)
# Authorized redirect URIs: not required for GIS ID-token button flow
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Demo guidata (D-080) — richiesta via email (niente Calendly)
DEMO_CONTACT_EMAIL=mcnicastro@gmail.com

# --- Firma elettronica (M5.S8 / D-042) — DocuSign/Yousign, no QES proprietaria ---
# ESIGN_PROVIDER=mock|yousign|docusign
ESIGN_PROVIDER=mock
# YOUSIGN_API_KEY=
# YOUSIGN_API_BASE=https://api-sandbox.yousign.app/v3
# DOCUSIGN_ACCESS_TOKEN=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# --- OpenAPI.it Catasto (visure ufficiali) ---
# Sandbox (onda D / Cloud Agent): UNA sola key nel vault —
#   OPENAPI_ENABLED=true + OPENAPI_API_KEY  (email = ADMIN_EMAIL / OPENAPI_EMAIL)
#   Host default = test.catasto / test.oauth (no OPENAPI_CATASTO_BASE needed)
# Produzione: OPENAPI_MODE=live + OPENAPI_EMAIL + OPENAPI_API_KEY (prod)
# Alternative: paste a pre-generated Bearer as OPENAPI_TOKEN
OPENAPI_ENABLED=false
# OPENAPI_API_KEY=
# OPENAPI_EMAIL=   # opzionale in sandbox se ADMIN_EMAIL è già il login console
# OPENAPI_TOKEN=
# OPENAPI_MODE=sandbox   # sandbox (default) | live
# OPENAPI_CATASTO_BASE=https://test.catasto.openapi.it
# OPENAPI_OAUTH_BASE=https://test.oauth.openapi.com
# OPENAPI_SCOPES=*:test.catasto.openapi.it/*

# --- Monitoring / alerts (go-live) ---
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.05
# ERROR_ALERT_WEBHOOK=https://hooks.slack.com/services/...
# ERROR_ALERT_EMAIL=you@example.com
# ERROR_ALERT_MAX_PER_HOUR=20
# OMNIA_ENV=production

# --- GitHub omnia2 (FALLBACK only) ---
# Via principale: avvia il Cloud Agent sul repo GitHub mcnicastro-netizen/omnia2
# e usa `git push origin` (auth Cursor nativa). GITHUB_TOKEN non serve.
# Fallback se l'agent è su Origin-tmp: imposta il secret Environment e
# `bash scripts/github-omnia2-push.sh`. Non usare Origin come source of truth.
# GITHUB_TOKEN=
