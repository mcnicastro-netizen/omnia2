# OMNIA backend — copy to .env and fill values. Never commit .env.

# --- Core (required) ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=omnia
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
COOKIE_SECURE=false

# --- Public URLs ---
FRONTEND_URL=http://127.0.0.1:43122
FRONTEND_BASE_URL=http://127.0.0.1:43122
OMNIA_PUBLIC_URL=http://127.0.0.1:43122
PUBLIC_BASE_URL=http://127.0.0.1:43121
REACT_APP_BACKEND_URL=http://127.0.0.1:43121

# --- LLM (post-M1: Gemini replaces Emergent) ---
# GEMINI_API_KEY=
# Legacy Emergent (deprecated — remove after M1)
# EMERGENT_LLM_KEY=

# --- Object storage (post-M1: S3/R2 or local filesystem) ---
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# --- Email ---
# RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# --- Stripe (sandbox) ---
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MODE=test

# --- Media AI ---
# FAL_KEY=

# --- Optional ---
# TAVILY_API_KEY=
# CREDENTIALS_MASTER_KEY=
# OMNIA_CUSTOM_DOMAIN_CNAME_TARGET=
