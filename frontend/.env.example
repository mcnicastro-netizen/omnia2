# OMNIA frontend — copy to .env for local; on Vercel set Project → Environment Variables

# API base for the SPA.
# - EMPTY → same-origin /api (Cloud tunnel + preview-server, or CRA proxy)
# - PRODUCTION (Vercel) → absolute API origin WITHOUT trailing slash, e.g.:
#     REACT_APP_BACKEND_URL=https://api.omniarealestateecosystem.it
#   (api.js appends /api → https://api…/api)
REACT_APP_BACKEND_URL=

# Local CRA only (ignored on Vercel)
PORT=43122
