{
  "name": "omnia2-cloud",
  "user": "ubuntu",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "install": "bash /workspace/scripts/cloud-agent-install.sh",
  "start": "bash /workspace/scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "omnia-stack-watch",
      "command": "bash /workspace/scripts/omnia-stack.sh watch",
      "description": "Keeps API + preview healthy and prints the public CRM URL."
    }
  ],
  "ports": [
    {
      "name": "omnia-preview",
      "port": 43123
    },
    {
      "name": "omnia-api",
      "port": 43121
    }
  ]
}
